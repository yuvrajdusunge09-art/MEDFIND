# MEDIFIND Environment Variables
# Copy this file to .env or .env.local to connect to your live Supabase project.

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (from your Supabase Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
